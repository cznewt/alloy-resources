// Blackbox probes through Alloy's embedded blackbox_exporter
// (prometheus.exporter.blackbox): HTTP status, TCP + TLS handshake, ICMP - and
// the certificate every TLS endpoint serves (probe_ssl_earliest_cert_expiry,
// probe_ssl_last_chain_expiry_timestamp_seconds).
//
// Targets are maps with `__address__`, `name` and `module`, typically from a
// discovery.relabel that sets those three labels:
//
//   {"__address__" = "10.50.51.16:6443", "name" = "apiserver-10.50.51.16", "module" = "kube_apiserver"}
//
// Target discovery for Kubernetes: `kube_api` (every apiserver + kubelet
// serving certificate) and `ingresses` (Ingresses annotated
// prometheus.io/probe="true" - kapitannet sets it on every ingress it renders).
//
// Default modules (argument `config`):
//   http_2xx        HTTP(S) GET that must answer 2xx
//   http_reachable  HTTP(S) GET that counts as up on 2xx, 3xx, 401 and 403 -
//                   the service answers, even behind auth or a redirect -
//                   without following redirects; TLS verified, so an invalid
//                   or expired certificate fails the probe (the ingress default)
//   tls             TCP + TLS handshake; the certificate is read but NOT
//                   verified - self-signed endpoints such as a kubelet (:10250)
//   kube_apiserver  TCP + TLS verified against the in-cluster service-account
//                   CA as `kubernetes`, so a wrong or expired apiserver
//                   certificate fails the probe, not only shows its expiry
//                   (in-cluster only: the CA file is the pod's token mount)
//   icmp            ping
//
// Every probe's series carry job=<job_label> (default integrations/blackbox)
// and instance=<target name>.

// Kubernetes control plane: every apiserver behind default/kubernetes (module
// kube_apiserver: TLS verified against the in-cluster service-account CA) and
// every node's kubelet serving certificate on :10250 (module tls: read, not
// verified - kubelets are usually self-signed). Needs list/watch on
// endpointslices and nodes (the k8s-monitoring Alloy service account has it).
declare "kube_api" {
  argument "kubelets" {
    comment = "Probe every node's kubelet too (default: true)"
    optional = true
  }

  argument "apiserver_module" {
    comment = "Module for the apiservers (default: kube_apiserver)"
    optional = true
  }

  argument "kubelet_module" {
    comment = "Module for the kubelets (default: tls)"
    optional = true
  }

  discovery.kubernetes "apiservers" {
    role = "endpointslice"

    namespaces {
      names = ["default"]
    }
  }

  discovery.relabel "apiservers" {
    targets = discovery.kubernetes.apiservers.targets

    rule {
      source_labels = ["__meta_kubernetes_endpointslice_label_kubernetes_io_service_name", "__meta_kubernetes_endpointslice_port_name"]
      regex         = "kubernetes;https"
      action        = "keep"
    }

    rule {
      source_labels = ["__address__"]
      regex         = "(.+):[0-9]+"
      replacement   = "apiserver-$1"
      target_label  = "name"
    }

    rule {
      replacement  = coalesce(argument.apiserver_module.value, "kube_apiserver")
      target_label = "module"
    }
  }

  discovery.kubernetes "nodes" {
    role = "node"
  }

  discovery.relabel "kubelets" {
    targets = discovery.kubernetes.nodes.targets

    // kubelets = false drops them all
    rule {
      replacement  = string.format("%v", coalesce(argument.kubelets.value, true))
      target_label = "__tmp_enabled"
    }

    rule {
      source_labels = ["__tmp_enabled"]
      regex         = "true"
      action        = "keep"
    }

    rule {
      source_labels = ["__meta_kubernetes_node_name"]
      replacement   = "kubelet-$1"
      target_label  = "name"
    }

    rule {
      replacement  = coalesce(argument.kubelet_module.value, "tls")
      target_label = "module"
    }
  }

  export "output" {
    value = array.concat(discovery.relabel.apiservers.output, discovery.relabel.kubelets.output)
  }
}

// Kubernetes Ingresses: one target per host + path, probed at
// <scheme>://<host><path> (scheme https when the ingress has TLS for the
// host). Annotations on the Ingress:
//   prometheus.io/probe: "true"        opt in (kapitannet sets it on every
//                                      ingress); "false" opts out even with
//                                      probe_all
//   prometheus.io/probe-module: <m>    module (default: the `module` argument)
//   prometheus.io/probe-path: </p>     path to probe instead of the rule's
// Targets also carry namespace and ingress labels.
declare "ingresses" {
  argument "namespaces" {
    comment = "The namespaces to look for ingresses in (default: [] is all namespaces)"
    optional = true
  }

  argument "probe_all" {
    comment = "Probe every ingress unless annotated prometheus.io/probe=\"false\", not only the opted-in ones (default: false)"
    optional = true
  }

  argument "module" {
    comment = "Module for ingresses without a prometheus.io/probe-module annotation (default: http_reachable)"
    optional = true
  }

  argument "hosts_exclude" {
    comment = "Regular expression of hosts not to probe, e.g. names only a VPN resolves (default: none)"
    optional = true
  }

  discovery.kubernetes "ingresses" {
    role = "ingress"

    namespaces {
      names = coalesce(argument.namespaces.value, [])
    }
  }

  discovery.relabel "ingresses" {
    targets = discovery.kubernetes.ingresses.targets

    // opted in ("true"), or - with probe_all - not opted out
    rule {
      replacement  = string.format("%v", coalesce(argument.probe_all.value, false))
      target_label = "__tmp_probe_all"
    }

    rule {
      source_labels = ["__meta_kubernetes_ingress_annotation_prometheus_io_probe", "__tmp_probe_all"]
      separator     = ";"
      regex         = "true;.*|;true"
      action        = "keep"
    }

    // a rule without a host cannot be probed by name
    rule {
      source_labels = ["__meta_kubernetes_ingress_host"]
      regex         = ""
      action        = "drop"
    }

    rule {
      source_labels = ["__meta_kubernetes_ingress_host"]
      regex         = coalesce(argument.hosts_exclude.value, "^$")
      action        = "drop"
    }

    // the rule's path, unless prometheus.io/probe-path overrides it
    rule {
      source_labels = ["__meta_kubernetes_ingress_path"]
      target_label  = "__tmp_path"
    }

    rule {
      source_labels = ["__meta_kubernetes_ingress_annotation_prometheus_io_probe_path"]
      regex         = "(.+)"
      target_label  = "__tmp_path"
    }

    rule {
      source_labels = ["__meta_kubernetes_ingress_scheme", "__meta_kubernetes_ingress_host", "__tmp_path"]
      separator     = ";"
      regex         = "(.+);(.+);(.*)"
      replacement   = "$1://$2$3"
      target_label  = "__address__"
    }

    rule {
      source_labels = ["__meta_kubernetes_ingress_host", "__tmp_path"]
      separator     = ""
      target_label  = "name"
    }

    rule {
      replacement  = coalesce(argument.module.value, "http_reachable")
      target_label = "module"
    }

    rule {
      source_labels = ["__meta_kubernetes_ingress_annotation_prometheus_io_probe_module"]
      regex         = "(.+)"
      target_label  = "module"
    }

    rule {
      source_labels = ["__meta_kubernetes_namespace"]
      target_label  = "namespace"
    }

    rule {
      source_labels = ["__meta_kubernetes_ingress_name"]
      target_label  = "ingress"
    }
  }

  export "output" {
    value = discovery.relabel.ingresses.output
  }
}

declare "exporter" {
  argument "targets" {
    comment = "Must be a list() of targets: maps with __address__, name and module"
  }

  argument "config" {
    comment = "blackbox_exporter configuration (YAML) with the modules targets name (default: see above)"
    default = `
modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      preferred_ip_protocol: ip4
  http_reachable:
    prober: http
    timeout: 5s
    http:
      preferred_ip_protocol: ip4
      no_follow_redirects: true
      valid_status_codes: [200, 201, 202, 204, 301, 302, 303, 304, 307, 308, 401, 403]
  tls:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
      tls: true
      tls_config:
        insecure_skip_verify: true
  kube_apiserver:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
      tls: true
      tls_config:
        ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        server_name: kubernetes
  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: ip4
`
    optional = true
  }

  argument "job_label" {
    comment = "The job label to add for all metrics (default: integrations/blackbox)"
    optional = true
  }

  prometheus.exporter.blackbox "exporter" {
    config  = argument.config.value
    targets = argument.targets.value
  }

  // Alloy names each probe's job integrations/blackbox/<target name> and sets
  // instance to the Alloy host. Move the target name to instance instead - the
  // usual blackbox convention, so a series (and an alert) names what it probed.
  discovery.relabel "exporter" {
    targets = prometheus.exporter.blackbox.exporter.targets

    rule {
      source_labels = ["job"]
      regex         = "integrations/blackbox/(.+)"
      target_label  = "instance"
    }

    rule {
      target_label = "job"
      replacement  = coalesce(argument.job_label.value, "integrations/blackbox")
    }
  }

  export "output" {
    value = discovery.relabel.exporter.output
  }
}

declare "scrape" {
  argument "targets" {
    comment = "Must be a list() of targets"
  }

  argument "forward_to" {
    comment = "Must be a list(MetricsReceiver) where collected metrics should be forwarded to"
  }

  argument "keep_metrics" {
    comment = "A regular expression of metrics to keep"
    default = "(.+)"
    optional = true
  }

  argument "drop_metrics" {
    comment = "A regular expression of metrics to drop (default: see below)"
    default = "(^(go|process)_.+$)"
    optional = true
  }

  argument "scrape_interval" {
    comment = "How often to probe the targets (default: 60s)"
    optional = true
  }

  argument "scrape_timeout" {
    comment = "How long before a probe times out (default: 10s)"
    optional = true
  }

  argument "max_cache_size" {
    comment = "The maximum number of elements to hold in the relabeling cache (default: 100000).  This should be at least 2x-5x your largest scrape target or samples appended rate."
    optional = true
  }

  argument "clustering" {
    // Docs: https://grafana.com/docs/alloy/latest/get-started/clustering/
    comment = "Whether or not clustering should be enabled (default: false)"
    optional = true
  }

  // blackbox scrape job: every scrape runs the probe
  prometheus.scrape "blackbox" {
    forward_to = [prometheus.relabel.blackbox.receiver]
    targets = argument.targets.value
    scrape_interval = coalesce(argument.scrape_interval.value, "60s")
    scrape_timeout = coalesce(argument.scrape_timeout.value, "10s")

    clustering {
      enabled = coalesce(argument.clustering.value, false)
    }
  }

  // blackbox metric relabelings (post-scrape)
  prometheus.relabel "blackbox" {
    forward_to = argument.forward_to.value
    max_cache_size = coalesce(argument.max_cache_size.value, 100000)

    // drop metrics that match the drop_metrics regex
    rule {
      source_labels = ["__name__"]
      regex = argument.drop_metrics.value
      action = "drop"
    }

    // keep only metrics that match the keep_metrics regex
    rule {
      source_labels = ["__name__"]
      regex = coalesce(argument.keep_metrics.value, "(.+)")
      action = "keep"
    }
  }
}
