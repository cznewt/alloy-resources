// Blackbox probes through Alloy's embedded blackbox_exporter
// (prometheus.exporter.blackbox): HTTP status, TCP + TLS handshake, ICMP - and
// the certificate every TLS endpoint serves (probe_ssl_earliest_cert_expiry,
// probe_ssl_last_chain_expiry_timestamp_seconds).
//
// Targets are maps with `__address__`, `name` and `module`, typically from a
// discovery.relabel that sets those three labels:
//
//   {"__address__" = "10.50.51.16:6443", "name" = "apiserver-10.50.51.16", "module" = "kube_apiserver"}
//
// Default modules (argument `config`):
//   http_2xx        HTTP(S) GET that must answer 2xx
//   tls             TCP + TLS handshake; the certificate is read but NOT
//                   verified - self-signed endpoints such as a kubelet (:10250)
//   kube_apiserver  TCP + TLS verified against the in-cluster service-account
//                   CA as `kubernetes`, so a wrong or expired apiserver
//                   certificate fails the probe, not only shows its expiry
//                   (in-cluster only: the CA file is the pod's token mount)
//   icmp            ping
//
// Every probe's series carry job=<job_label> (default integrations/blackbox)
// and instance=<target name>.

declare "exporter" {
  argument "targets" {
    comment = "Must be a list() of targets: maps with __address__, name and module"
  }

  argument "config" {
    comment = "blackbox_exporter configuration (YAML) with the modules targets name (default: see above)"
    default = `
modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      preferred_ip_protocol: ip4
  tls:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
      tls: true
      tls_config:
        insecure_skip_verify: true
  kube_apiserver:
    prober: tcp
    timeout: 5s
    tcp:
      preferred_ip_protocol: ip4
      tls: true
      tls_config:
        ca_file: /var/run/secrets/kubernetes.io/serviceaccount/ca.crt
        server_name: kubernetes
  icmp:
    prober: icmp
    timeout: 5s
    icmp:
      preferred_ip_protocol: ip4
`
    optional = true
  }

  argument "job_label" {
    comment = "The job label to add for all metrics (default: integrations/blackbox)"
    optional = true
  }

  prometheus.exporter.blackbox "exporter" {
    config  = argument.config.value
    targets = argument.targets.value
  }

  // Alloy names each probe's job integrations/blackbox/<target name> and sets
  // instance to the Alloy host. Move the target name to instance instead - the
  // usual blackbox convention, so a series (and an alert) names what it probed.
  discovery.relabel "exporter" {
    targets = prometheus.exporter.blackbox.exporter.targets

    rule {
      source_labels = ["job"]
      regex         = "integrations/blackbox/(.+)"
      target_label  = "instance"
    }

    rule {
      target_label = "job"
      replacement  = coalesce(argument.job_label.value, "integrations/blackbox")
    }
  }

  export "output" {
    value = discovery.relabel.exporter.output
  }
}

declare "scrape" {
  argument "targets" {
    comment = "Must be a list() of targets"
  }

  argument "forward_to" {
    comment = "Must be a list(MetricsReceiver) where collected metrics should be forwarded to"
  }

  argument "keep_metrics" {
    comment = "A regular expression of metrics to keep"
    default = "(.+)"
    optional = true
  }

  argument "drop_metrics" {
    comment = "A regular expression of metrics to drop (default: see below)"
    default = "(^(go|process)_.+$)"
    optional = true
  }

  argument "scrape_interval" {
    comment = "How often to probe the targets (default: 60s)"
    optional = true
  }

  argument "scrape_timeout" {
    comment = "How long before a probe times out (default: 10s)"
    optional = true
  }

  argument "max_cache_size" {
    comment = "The maximum number of elements to hold in the relabeling cache (default: 100000).  This should be at least 2x-5x your largest scrape target or samples appended rate."
    optional = true
  }

  argument "clustering" {
    // Docs: https://grafana.com/docs/alloy/latest/get-started/clustering/
    comment = "Whether or not clustering should be enabled (default: false)"
    optional = true
  }

  // blackbox scrape job: every scrape runs the probe
  prometheus.scrape "blackbox" {
    forward_to = [prometheus.relabel.blackbox.receiver]
    targets = argument.targets.value
    scrape_interval = coalesce(argument.scrape_interval.value, "60s")
    scrape_timeout = coalesce(argument.scrape_timeout.value, "10s")

    clustering {
      enabled = coalesce(argument.clustering.value, false)
    }
  }

  // blackbox metric relabelings (post-scrape)
  prometheus.relabel "blackbox" {
    forward_to = argument.forward_to.value
    max_cache_size = coalesce(argument.max_cache_size.value, 100000)

    // drop metrics that match the drop_metrics regex
    rule {
      source_labels = ["__name__"]
      regex = argument.drop_metrics.value
      action = "drop"
    }

    // keep only metrics that match the keep_metrics regex
    rule {
      source_labels = ["__name__"]
      regex = coalesce(argument.keep_metrics.value, "(.+)")
      action = "keep"
    }
  }
}
